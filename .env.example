# ============================================================================
# Movio Streaming Platform — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values.
# ============================================================================

# --- WordPress Headless CMS (Pantheon) ---
WP_SITE_URL=https://dev-movio-stream.pantheonsite.io
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=your_wp_application_password_here

# --- Next.js Frontend Public API URL ---
NEXT_PUBLIC_WORDPRESS_API_URL=https://dev-movio-stream.pantheonsite.io/wp-json/wp/v2

# --- TMDB (The Movie Database) Official API ---
TMDB_API_KEY=your_tmdb_api_key_here

# --- Doodstream Video Hosting API ---
DOODSTREAM_API_KEY=your_doodstream_api_key_here
DOODSTREAM_BASE_URL=https://doodapi.com/api

# --- Download & Processing Settings ---
DOWNLOAD_DIR=/content/download
DEFAULT_QUALITY=1080p
