# ============================================================================
# Automated Legal Media Platform — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ============================================================================

# --- Doodstream API ---
DOODSTREAM_API_KEY=your_doodstream_api_key_here
DOODSTREAM_BASE_URL=https://doodapi.com/api
DOODSTREAM_RATE_LIMIT=50
DOODSTREAM_RATE_PERIOD=60
DOODSTREAM_MAX_CONCURRENT_REMOTE=5
DOODSTREAM_UPLOAD_TIMEOUT=1800

# --- OpenSubtitles API ---
OPENSUBTITLES_API_KEY=your_opensubtitles_api_key_here
OPENSUBTITLES_USERNAME=your_opensubtitles_username
OPENSUBTITLES_PASSWORD=your_opensubtitles_password
OPENSUBTITLES_USER_AGENT=LegalMediaPlatform v1.0
SUBTITLE_LANGUAGES=en,ar

# --- WordPress REST API ---
WP_SITE_URL=https://your-wordpress-site.com
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=your_wp_application_password
WP_DEFAULT_POST_STATUS=publish
WP_DEFAULT_CATEGORY=Movies

# --- TMDB (The Movie Database) ---
TMDB_API_KEY=your_tmdb_api_key_here

# --- OMDB ---
OMDB_API_KEY=your_omdb_api_key_here

# --- FFmpeg Settings ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_DEFAULT_PRESET=medium
FFMPEG_CRF=23
FFMPEG_MAX_RESOLUTION=1280:720
FFMPEG_AUDIO_BITRATE=128k
FFMPEG_MAX_THREADS=3
FFMPEG_TIMEOUT=7200
FFMPEG_CPU_THRESHOLD=60

# --- Backup Video Host (Streamtape) ---
BACKUP_HOST_ENABLED=false
BACKUP_HOST_NAME=streamtape
BACKUP_HOST_API_KEY=your_backup_host_api_key
BACKUP_HOST_API_LOGIN=your_backup_host_login

# --- Monitoring & Alerts ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
ALERT_ON_FAILURE=true

# --- Pipeline Tuning ---
MAX_ITEMS_PER_FETCH=10
FETCH_INTERVAL_HOURS=6
MAX_RETRIES_DOWNLOAD=3
MAX_RETRIES_TRANSCODE=2
MAX_RETRIES_UPLOAD=5
MAX_RETRIES_PUBLISH=3
